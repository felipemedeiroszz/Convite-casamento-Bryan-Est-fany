# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Asaas Payment Configuration
ASAAS_API_KEY=your_asaas_api_key
# OR use ASAAS_ACCESS_TOKEN if your key starts with $
ASAAS_ACCESS_TOKEN=your_asaas_access_token
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
# Use https://www.asaas.com/api/v3 for production

# Mock Payment Mode (for testing without Asaas API)
# Set to 'true' to use mock payments instead of real Asaas API
USE_MOCK_PAYMENT=true

# Webhook Configuration
ASAAS_WEBHOOK_SECRET=your_webhook_secret_for_verification
